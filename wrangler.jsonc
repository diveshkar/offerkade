{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offerceylon",
  "main": ".open-next/worker.js",
  // Serve only the custom domain (offerceylon.com). Keeps the
  // *.workers.dev URL disabled across deploys so it can't re-enable itself.
  "workers_dev": false,
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
